{
  "name": "betterlegazpi",
  "version": "1.1.21",
  "description": "BetterLegazpi.org - Official Portal for LGU Legazpi City",
  "scripts": {
    "dev": "python serve.py -p 8000 -d .",
    "build": "bash build.sh",
    "build:major": "bash scripts/build/version.sh major && bash build.sh --no-bump",
    "build:minor": "bash scripts/build/version.sh minor && bash build.sh --no-bump",
    "serve": "python serve.py -p 8000 -d .",
    "serve:dist": "python serve.py -p 8080 -d dist",
    "version:major": "node scripts/build/bump-version.js major",
    "version:minor": "node scripts/build/bump-version.js minor",
    "version:patch": "node scripts/build/bump-version.js patch",
    "version:check": "node scripts/build/bump-version.js",
    "hubs:fetch": "node scripts/data/fetch-charters.js",
    "hubs:validate": "node scripts/validate/validate-office-hubs.js",
    "hubs:render": "node scripts/build/render-office-hubs.js",
    "hubs:preview": "node scripts/validate/validate-office-hubs.js --allow-unverified && node scripts/build/render-office-hubs.js",
    "hubs:check": "node scripts/validate/validate-office-hubs.js && node scripts/build/render-office-hubs.js --check",
    "transport:validate": "node scripts/validate/validate-transport.js",
    "test": "playwright test",
    "test:unit": "node --test \"scripts/build/*.test.js\" \"scripts/validate/*.test.js\"",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "legazpi",
    "albay",
    "government",
    "lgu"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "terser": "^5.44.1"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  }
}
