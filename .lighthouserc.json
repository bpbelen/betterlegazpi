{
  "ci": {
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 667,
          "deviceScaleFactor": 2,
          "disabled": false
        }
      }
    }
  }
}
